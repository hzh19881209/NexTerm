# The service listens on this port inside the container.
PORT=3000
# Bind only to the host's LAN interface. The 192.168.X.0/24 network can
# access this address; public traffic should continue through the HTTPS proxy.
LAN_BIND_IP=192.168.X.X
# Change HOST_PORT if the default 3010 is already in use.
HOST_PORT=3010
APP_SECRET=replace-with-at-least-32-random-characters
PUBLIC_HOST=your.domain.com
DEPLOYMENT_SERVER_NAME=
PUBLIC_URL=https://your.domain.com
TLS_CERT_FILE=/app/certs/your.domain.com.crt
TLS_KEY_FILE=/app/certs/your.domain.com.key
# Keep detached SSH shells alive while a mobile browser is suspended (24 hours).
SSH_SESSION_GRACE_MS=86400000
# WebSocket ping interval, keeping FRP/Nginx idle connections alive.
WS_HEARTBEAT_MS=30000
# Login protection: 5 failures for the same IP+username locks for 15 minutes;
# the IP-wide ceiling is 30 failures in the same window.
LOGIN_WINDOW_MS=900000
LOGIN_MAX_ATTEMPTS=5
LOGIN_IP_MAX_ATTEMPTS=30
LOGIN_ACCOUNT_MAX_ATTEMPTS=12
LOGIN_LOCKOUT_MS=900000
# Opaque server-side login sessions expire after 12 hours.
SESSION_TTL_SECONDS=43200
PASSWORD_MIN_LENGTH=12
# Set to 1 when NexTerm is behind nginx/FRP and you need Express proxy awareness.
TRUST_PROXY=1
